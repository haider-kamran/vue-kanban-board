{
  "name": "openkanban-vue",
  "version": "1.0.0",
  "description": "A premium, fully interactive Trello-like Kanban board built with Vue 3, TypeScript, Pinia, and Tailwind CSS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "main": "./dist/openkanban-vue.umd.js",
  "module": "./dist/openkanban-vue.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/openkanban-vue.es.js",
      "require": "./dist/openkanban-vue.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@vueuse/core": "^10.9.0",
    "vuedraggable": "^4.1.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "pinia": "^2.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vue-tsc": "^2.0.6",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19"
  }
}
